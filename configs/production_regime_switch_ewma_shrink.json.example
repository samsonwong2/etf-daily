{
  "description": "Production settings copied from the 2026-05-29 long command. Keep dates on the CLI.",
  "paths": {
    "provider_uri": "~/.qlib/qlib_data/all_fund_data",
    "qlib_scripts_dir": "",
    "temp_dir": "~/etf-daily-output",
    "workspace_dir": "{project_root}/workspace",
    "log_dir": "{workspace_dir}/logs",
    "plotly_outputs_dir": "~/etf-daily-output/plotly_outputs",
    "local_library_dir": "",
    "fund_list_csv": "{temp_dir}/fund_list.csv",
    "qlib_change_csv_dir": "{provider_uri}/change_csv",
    "all_instruments_txt": "{provider_uri}/instruments/all.txt",
    "cluster_mapping_path": "{provider_uri}/instruments/cluster_mapping_selected.txt"
  },
  "pipeline_args": {
    "mode": "full",
    "include_spot": true,
    "provider_uri": "{provider_uri}",
    "cluster_mapping_path": "{cluster_mapping_path}",
    "forecast_mu_method": "ewma60",
    "forecast_mu_model": "regime_switch_ewma_shrink",
    "forecast_mu_ewma_span": 60,
    "forecast_mu_regime_benchmark": "SH510300",
    "forecast_mu_regime_fast_ma": 20,
    "forecast_mu_regime_slow_ma": 60,
    "forecast_mu_regime_vol_window": 20,
    "forecast_mu_regime_vol_lookback": 120,
    "forecast_mu_regime_risk_off_shrink_alpha": 0.5,
    "forecast_mu_shrink_target": "zero",
    "forecast_mu_shrink_alpha": 0.75,
    "forecast_mu_scale": 1.0,
    "forecast_mu_min_periods": 20,
    "forecast_mu_asof_lag": 1,
    "forecast_mu_missing_fill": "zero",
    "forecast_mu_overwrite": true,
    "mu_preset": "simple_pulse_mu",
    "mean_overlay_mode": "shadow",
    "mean_overlay_factor_fund_list_csv": "{fund_list_csv}",
    "spot_csv": "{temp_dir}/fund_etf_category_sina_df.csv",
    "temp_dir": "{temp_dir}/runs/{end_yyyymmdd}/prod",
    "max_weight_cap": 0.15,
    "min_weight_floor": 0.05,
    "regime_gate_min_scale": 0.5,
    "variance_floor_quantile": 0.5,
    "corr_floor": 0.1,
    "rebalance_mode": "adaptive",
    "rebalance_min_gap_days": 10,
    "rebalance_max_gap_days": 18,
    "rebalance_drift_threshold": 1.0,
    "rebalance_exposure_change_threshold": 0.1,
    "rebalance_risk_change_threshold": 0.1,
    "rebalance_score_threshold": 0.0002,
    "rebalance_min_expected_return_gain": 0.0,
    "rebalance_risk_aversion": 1.0,
    "rebalance_corr_bonus_weight": 0.0002,
    "rebalance_turnover_cost": 0.0001,
    "rebalance_score_gate_mode": "off",
    "route_max_workers": 8,
    "audit_level": "full"
  }
}
